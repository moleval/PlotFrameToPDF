(defun psp-t9b ( / s n)
  (setq s "D:\\Yandex.Disk\\")
  (while (and (> (strlen s) 0) (= (substr s (strlen s) 1) "\\"))
    (setq s (substr s 1 (1- (strlen s)))))
  (setq *psp-pdf-dir* s)
  (setcfg "AppData/PlotSPDS/PDFDir" s)
  (setq n (atoi "3"))
  (if (< n 1) (setq n 1))
  (setcfg "AppData/PlotSPDS/AutoMergeN" (itoa n))
  (princ "\nT9b-OK dir=")
  (princ *psp-pdf-dir*)
  (princ))
(princ)
