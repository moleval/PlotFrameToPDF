(setq *psp-pc3* "PlotSPDSToPDF.pc3")

;; Восстановление настроек из реестра (записывает ПСПНАСТРОЙКИ)
(defun psp-load-cfg ( / s n)
  (setq s (getcfg "AppData/PlotSPDS/PDFDir"))
  (if (and (= (type s) 'STR) (/= s ""))
    (setq *psp-pdf-dir* s *psp-output-dir* s))
  ;; Параметры печати (задача 12): подхват в ОБА модуля
  ;; (СПДС печатает по *psp-*, база — по *pfp-*)
  (setq s (getcfg "AppData/PlotFrame/ColorMode"))
  (if (= (type s) 'STR)
    (setq *pfp-color-mode* (= s "1") *psp-color-mode* (= s "1")))
  (setq s (getcfg "AppData/PlotFrame/CtbMono"))
  (if (and (= (type s) 'STR) (/= s ""))
    (setq *pfp-ctb-mono* s *psp-ctb-mono* s))
  (setq s (getcfg "AppData/PlotFrame/CtbColor"))
  (if (and (= (type s) 'STR) (/= s ""))
    (setq *pfp-ctb-color* s *psp-ctb-color* s))
  (setq s nil n (getcfg "AppData/PlotSPDS/AutoMergeN"))
  (if (= (type n) 'STR) (setq s (atoi n)))
  (if (and (numberp s) (> s 0)) (setq *psp-auto-merge-n* s))
  (setq s nil n (getcfg "AppData/PlotSPDS/OpenDelay"))
  (if (= (type n) 'STR) (setq s (atoi n)))
  (if (and (numberp s) (>= s 0)) (setq *psp-open-delay-s* s))
  (setq s (getcfg "AppData/PlotSPDS/OpenRes"))
  (cond ((= s "1") (setq *psp-open-res* T))
        ((= s "0") (setq *psp-open-res* nil)))
  (setq s (getcfg "AppData/PlotSPDS/DelSingles"))
  (cond ((= s "1") (setq *psp-del-singles* T))
        ((= s "0") (setq *psp-del-singles* nil)))
  (setq s (getcfg "AppData/PlotSPDS/PC3"))
  (if (and (= (type s) 'STR) (/= s "")
           (wcmatch (strcase s T) "*`.pc3"))
    (setq *psp-pc3* s))
  (setq s nil n (getcfg "AppData/PlotSPDS/Quality"))
  (if (= (type n) 'STR) (setq s (atoi n)))
  (if (and (numberp s) (>= s 0) (<= s 2)) (setq *psp-quality* s))
  (princ))
(psp-load-cfg)

