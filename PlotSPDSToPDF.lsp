;; Наборы вопросов -ПЕЧАТЬ у Модели и Листа различаются: у Модели нет
;; вопросов «лист последним»/«удалять скрытые», но есть «Задать
;; тонирование» (ответ — ключевое слово). Лента собирается по TILEMODE.
(defun psp-plot-tape (fname media-name rot-str ctb x1 y1 x2 y2
                      media-chk alt / tape old-cmdecho)
  (setq old-cmdecho (getvar "CMDECHO"))
  (setvar "CMDECHO" (if *psp-plot-echo* 1 0))
  (setq tape
    (append
      (list "_.-plot"
            "_Y"                     ; подробная настройка
            ""                       ; текущий лист
            *psp-pc3*                ; устройство
            (cond                     ; nil в ленте command недопустим!
              ((= 1 (getvar "TILEMODE")) "") ;Лист: Enter — формат уже
                                       ;предустановлен; лист хранит ПОРТ-
                                       ;РЕТНЫЙ канон, шлём Enter, а не план
              ((= (type media-chk) 'STR) media-chk) ;Модель: факт преду-
                                       ;становки (обычно совпадает с планом)
              (t media-name))
            "_M"                     ; мм
            rot-str                  ; ориентация _L / _P
            "_N"                     ; не переворачивать
            "_W"                     ; область: Рамка
            (list x1 y1)             ; нижний левый угол
            (list x2 y2)             ; верхний правый угол
            "_F"                     ; вписать
            "_C"                     ; центрировать
            "_Y"                     ; учитывать стили печати
            ctb                      ; CTB-файл
            "_Y")                    ; учитывать веса линий
      ;; В части сборок AutoCAD есть вопрос «Масштабировать веса линий?»,
      ;; в части (см. транскрипт 0.24) его нет. По умолчанию НЕТ (лишний
      ;; ответ сдвигал ленту: имя файла получало "_As"). Переключение:
      ;; ПСПЛЕНТА / PSPTAPE.
      (if (= 1 (getvar "TILEMODE"))
        ;; --- вкладка Модель ---
        (append
          (if *psp-tape-mode*        ; «Масштабировать веса?» задаёт не
            (list "_N"))             ; каждая сборка (см. ПСПЛЕНТА)
          (list
            "_As"                    ; тонирование: по отображению
            fname                    ; имя файла
            "_N"                     ; не сохранять в параметры
            "_Y"))                   ; печатать
        ;; --- вкладка Лист ---
        ;; Три «Нет» (масштабировать веса / печатать лист первым /
        ;; скрывать объекты листа). Вопрос «записать изменения в
        ;; макет» появляется ТОЛЬКО когда настройки печати отлича-
        ;; ются от сохранённых в листе, поэтому постоянного ответа
        ;; под него нет: второй заход (alt) шлёт четвёртое «Нет».
        (append
          (list "_N" "_N" "_N")
          (if alt (list "_N"))
          (list fname "_N" "_Y")))))
  (apply 'command tape)
  (setvar "CMDECHO" old-cmdecho)
  t)

