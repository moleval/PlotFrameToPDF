;; Качество печати SPDS: 0 = формат в формат, 1 = +1, 2 = +2
(defun c:ПСПКАЧ ( / s names)
  (setq names (list "Низкое (формат в формат)"
                    "Среднее (+1 формат)"
                    "Высокое (+2 формата)"))
  (initget "Низкое Среднее Высокое _ Low Med High")
  (setq s (getkword (strcat "\nКачество печати [Низкое/Среднее/Высокое] <"
                            (nth *psp-quality*
                                 (list "Низкое" "Среднее" "Высокое"))
                            ">: ")))
  (cond
    ((null s))                                   ; Enter — оставить
    ((member (strcase s)
             (list (strcase "Низкое") (strcase "Low"))) (setq *psp-quality* 0))
    ((member (strcase s)
             (list (strcase "Высокое") (strcase "High"))) (setq *psp-quality* 2))
    (t (setq *psp-quality* 1)))
  (setcfg "AppData/PlotSPDS/Quality" (itoa *psp-quality*))
  (princ (strcat "\nПСП: качество печати — " (nth *psp-quality* names) "."))
  (princ))
(defun c:PSPQUAL () (c:ПСПКАЧ))

;; Справка: команды и однократная настройка «тихого» PDF-принтера
(defun c:ПСППОМОЩЬ ( )
  (princ (strcat "\nPlotSPDSToPDF v" *psp-ver* " — экспорт форматов СПДС в PDF."))
  (princ "\nКоманды: ЭКССПДСВПДФ (SPDSTOPDF) — экспорт; ПСПНАСТРОЙКИ (PSPSET) —")
  (princ "\n  настройки (папка PDF, автосборка, задержка, принтер, удаление);")
  (princ "\n  ПСППАПКА (PSPPAPKA) — папка сборок; ПСПГС (PSPGS) — путь к Ghostscript;")
  (princ "\n  страховой поиск: <диск>:\\PlotFrameToPDF\\gs\\bin (C:/D:/E:) — портативный gs.")
  (princ "\n  ПСПЭХОВКЛ/ПСПЭХОВЫКЛ — эхо ленты -ПЕЧАТЬ; ПСППОМОЩЬ (PSPHELP) — справка.")
  (princ "\nКачество печати: ПСПКАЧ (PSPQUAL) — Низкое=формат-в-формат,")
  (princ "\n  Среднее=+1 формат, Высокое=+2 формата; также в ПСПНАСТРОЙКИ.")
  (princ "\nКачество базы (ЭКСВПДФ) — нижняя радиострока в ПСПНАСТРОЙКИ.")
  (princ "\nПорядок листов: по номеру (15, 15.1, 15.2...), «0» — титульный, первым.")
  (princ "\nБольше трёх листов — сборка в один PDF автоматически;")
  (princ "\n  открывается ТОЛЬКО склейка, одиночные листы не запускаются")
  (princ "\n  и удаляются (повторные попытки ~1 мин — просмотрщик держит файлы).")
  (princ "\nОДНОКРАТНАЯ НАСТРОЙКА «тихого» принтера (если AutoCAD сам")
  (princ "\nоткрывает каждый отпечатанный лист):")
  (princ "\n  1) открыть папку принтеров: в консоли AutoCAD —")
  (princ "\n       (startapp \"explorer.exe\" (getenv \"PrinterConfigDir\"))")
  (princ "\n     (команда ПЛОТТЕРМАНАДЖЕР может не открываться — не страшно)")
  (princ "\n  2) копия DWG To PDF.pc3 -> переименовать в PlotSPDSToPDF.pc3")
  (princ "\n  3) двойной клик по копии -> «Пользовательские свойства...» ->")
  (princ "\n     снять флажок «Показывать результаты в программе просмотра» -> OK")
  (princ "\n  4) в модуле имя уже задано по умолчанию; после загрузки можно")
  (princ "\n     переопределить: (setq *psp-pc3* \"PlotSPDSToPDF.pc3\")")
  (princ "\n  Если копии нет, экспорт падает с «устройство не найдено» — тогда")
  (princ "\n  (setq *psp-pc3* \"DWG To PDF.pc3\") после загрузки.")
  (princ))

(defun c:PSPPOMOSH () (c:ПСППОМОЩЬ))
(defun c:PSPHELP () (c:ПСППОМОЩЬ))

(defun c:ПСППАПКА ( / d)
  (setq d (psp-output-dir))
  (if (vl-file-directory-p d)
    (progn
      (startapp "explorer.exe" d)
      (princ (strcat "\nПСП: папка открыта — " d)))
    (princ (strcat "\nПСП: папка не существует — " d)))
  (princ))
(defun c:PSPPAPKA () (c:ПСППАПКА))

;; Диагностика: показывать/скрывать все подсказки -ПЕЧАТЬ во время
;; серийной печати (эхо команд в консоль)
(defun psp-echo-set (v)
  (setq *psp-plot-echo* v)
  (princ (if v
    "\nПСП: эхо печати ВКЛЮЧЕНО — подсказки -ПЕЧАТЬ будут видны."
    "\nПСП: эхо печати выключено."))
  (princ))
(defun c:ПСПЭХОВКЛ () (psp-echo-set T))
(defun c:ПСПЭХОВЫКЛ () (psp-echo-set nil))
(defun c:PSPECHOON () (psp-echo-set T))
(defun c:PSPECHOOFF () (psp-echo-set nil))

;; Переключение ленты -ПЕЧАТЬ: с ответом на «Масштабировать веса
;; линий?» или без (зависит от сборки AutoCAD)
(defun c:ПСПЛЕНТА ( )
  (setq *psp-tape-mode* (not *psp-tape-mode*))
  (princ (if *psp-tape-mode*
    "\nПСП: лента с ответом «Масштабировать веса линий?»."
    "\nПСП: лента без ответа «Масштабировать веса линий?» (как в транскрипте 0.24)."))
  (princ))
(defun c:PSPTAPE () (c:ПСПЛЕНТА))

;; Задать путь к Ghostscript вручную и запомнить его постоянно
(defun c:ПСПГС ( / p)
  (setq p (getstring T
    "\nПолный путь к gswin64c.exe (Enter — очистить): "))
  (if (= p "")
    (progn
      (setq *psp-gs* nil)
      (setcfg "AppData/PlotSPDS/GS" "")
      (princ "\nПСП: путь к Ghostscript очищен, поиск автоматический."))
    (progn
      (setq p (vl-string-trim " \"" p))
      (setq *psp-gs* p)
      (setcfg "AppData/PlotSPDS/GS" p)
      (princ (strcat "\nПСП: Ghostscript: " p
                     "\nПСП: если склейка не соберётся — проверьте путь."))))
  (princ))
(defun c:PSPGS () (c:ПСПГС))
(princ (strcat "\nПСП: секция 10/10 загружена")) (princ)
